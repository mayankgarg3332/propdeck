# Copy to .env when using Docker, or let docker-compose environment override these.

APP_URL=http://localhost:8000

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=propdeck
DB_USERNAME=root
DB_PASSWORD=secret

VITE_DEV_SERVER_URL=http://localhost:5173

# Set true on first run to load demo data: docker compose run --rm -e RUN_SEED=true app php artisan db:seed --force
RUN_SEED=false
